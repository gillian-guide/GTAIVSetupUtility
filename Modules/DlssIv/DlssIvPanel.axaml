<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dlss="clr-namespace:GTAIVSetupUtility.Modules.DlssIv"
             xmlns:lang="clr-namespace:GTAIVSetupUtility.Localizations"
             x:Class="GTAIVSetupUtility.Modules.DlssIv.DlssIvPanel"
             x:DataType="dlss:DlssIvViewModel"
             x:CompileBindings="True"
             IsVisible="{Binding IsVisible}">

    <StackPanel Margin="0,3,0,0" Spacing="5">
        <Separator/>

        <TextBlock Text="{x:Static lang:Resources.DlssIvDescription}"
                   FontSize="11"
                   Foreground="Gray"
                   TextWrapping="Wrap"/>

        <!-- On/off and upscaler -->
        <WrapPanel Orientation="Horizontal">
            <CheckBox Content="{x:Static lang:Resources.DlssIvEnable}"
                      IsChecked="{Binding IsModEnabled}"
                      IsEnabled="{Binding CanToggleMod}"
                      Command="{Binding ToggleModCommand}"
                      ToolTip.Tip="{x:Static lang:Resources.DlssIvEnableTip}"
                      Margin="0,0,14,0"/>

            <TextBlock Text="{x:Static lang:Resources.DlssIvUpscalerLabel}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding UpscalerOptions}"
                      SelectedIndex="{Binding SelectedUpscalerIndex}"
                      IsEnabled="{Binding IsUpscalerComboEnabled}"
                      MinWidth="100"/>
        </WrapPanel>

        <!-- Preset / FSR profile, plus the quality choice -->
        <WrapPanel Orientation="Horizontal">
            <TextBlock Text="{x:Static lang:Resources.DlssIvPresetLabel}"
                       IsVisible="{Binding IsProfileVisible}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <ComboBox ItemsSource="{Binding ProfileOptions}"
                      SelectedIndex="{Binding SelectedProfileIndex}"
                      IsEnabled="{Binding IsProfileEnabled}"
                      IsVisible="{Binding IsProfileVisible}"
                      MinWidth="190"
                      Margin="0,0,16,0"/>

            <TextBlock Text="{x:Static lang:Resources.DlssIvQualityLabel}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <RadioButton Content="{x:Static lang:Resources.DlssIvDlaa}"
                         GroupName="DlssIvQuality"
                         IsChecked="{Binding IsDlaaSelected}"
                         IsEnabled="{Binding IsSettingsEnabled}"
                         Margin="0,0,8,0"/>
            <RadioButton Content="{x:Static lang:Resources.DlssIvQuality}"
                         GroupName="DlssIvQuality"
                         IsChecked="{Binding IsQualitySelected}"
                         IsEnabled="{Binding IsSettingsEnabled}"/>
        </WrapPanel>

        <!-- HDR and the individual PERFORMANCE toggles -->
        <WrapPanel Orientation="Horizontal">
            <CheckBox Content="{x:Static lang:Resources.DlssIvHdr}"
                      IsChecked="{Binding IsHdrEnabled}"
                      IsEnabled="{Binding IsSettingsEnabled}"
                      Command="{Binding HdrClickCommand}"
                      Margin="0,0,14,0"/>

            <TextBlock Text="{x:Static lang:Resources.DlssIvPerformance}"
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       Margin="0,0,6,0"/>
            <CheckBox Content="{x:Static lang:Resources.DlssIvThreaded}"
                      IsChecked="{Binding IsThreadedEnabled}"
                      IsEnabled="{Binding IsSettingsEnabled}"
                      ToolTip.Tip="{x:Static lang:Resources.DlssIvThreadedTip}"
                      Margin="0,0,10,0"/>
            <CheckBox Content="{x:Static lang:Resources.DlssIvUnpin}"
                      IsChecked="{Binding IsUnpinEnabled}"
                      IsEnabled="{Binding IsSettingsEnabled}"
                      ToolTip.Tip="{x:Static lang:Resources.DlssIvUnpinTip}"
                      Margin="0,0,10,0"/>
            <CheckBox Content="{x:Static lang:Resources.DlssIvCpuPlace}"
                      IsChecked="{Binding IsCpuPlaceEnabled}"
                      IsEnabled="{Binding IsSettingsEnabled}"
                      ToolTip.Tip="{x:Static lang:Resources.DlssIvCpuPlaceTip}"
                      Margin="0,0,10,0"/>
            <CheckBox Content="{x:Static lang:Resources.DlssIvRenameSdr}"
                      IsChecked="{Binding IsRenameSdrEnabled}"
                      IsEnabled="{Binding IsSettingsEnabled}"
                      ToolTip.Tip="{x:Static lang:Resources.DlssIvRenameSdrTip}"/>
        </WrapPanel>

        <!-- Frame generation (latest DLSS-IV) -->
        <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsFrameGenerationAvailable}">
            <CheckBox Content="{x:Static lang:Resources.DlssIvFrameGeneration}"
                      IsChecked="{Binding IsFrameGenerationEnabled}"
                      IsEnabled="{Binding IsSettingsEnabled}"
                      ToolTip.Tip="{x:Static lang:Resources.DlssIvFrameGenerationTip}"
                      Margin="0,0,10,0"/>
            <TextBlock Text="{x:Static lang:Resources.DlssIvFrameGenerationMinFps}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <NumericUpDown Value="{Binding FrameGenerationMinFps, Mode=TwoWay}"
                           Minimum="0"
                           Maximum="240"
                           Increment="1"
                           FormatString="0"
                           PlaceholderText="0"
                           ShowButtonSpinner="False"
                           IsEnabled="{Binding IsSettingsEnabled}"
                           ToolTip.Tip="{x:Static lang:Resources.DlssIvFrameGenerationMinFpsTip}"
                           Width="80"/>
        </WrapPanel>

        <!-- Binary maintenance / supported FSR paths -->
        <WrapPanel Orientation="Horizontal">
            <Button Content="{x:Static lang:Resources.DlssIvUpdateDlss}"
                    Command="{Binding UpdateDlssCommand}"
                    IsEnabled="{Binding CanUpdateDlss}"
                    Margin="0,0,6,0"/>
            <Button Content="{x:Static lang:Resources.DlssIvUpdateFsr}"
                    Command="{Binding UpdateFsrCommand}"
                    IsEnabled="{Binding CanUpdateFsr}"
                    Margin="0,0,6,0"/>
            <Button Content="{Binding Fsr4CommunityButtonText}"
                    Command="{Binding InstallFsr4CommunityCommand}"
                    IsVisible="{Binding ShowFsr4CommunityButton}"
                    Margin="0,0,10,0"/>
            <TextBlock Text="{Binding ProgressText}"
                       IsVisible="{Binding IsBusy}"
                       FontSize="11"
                       Foreground="Gray"
                       VerticalAlignment="Center"/>
        </WrapPanel>

        <TextBlock Text="{Binding StatusText}"
                   IsVisible="{Binding HasStatusText}"
                   FontSize="11"
                   Foreground="Orange"
                   TextWrapping="Wrap"/>

        <Separator/>
    </StackPanel>
</UserControl>
