<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GTAIVSetupUtility.Controls"
             x:Class="GTAIVSetupUtility.Controls.TipContent"
             x:DataType="controls:TipContent"
             x:CompileBindings="True"
             MaxWidth="420">

    <StackPanel Spacing="3">
        <TextBlock Text="{Binding Title}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Description}"
                   TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
