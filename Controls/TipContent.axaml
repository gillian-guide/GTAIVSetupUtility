<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:GTAIVSetupUtility.Controls"
             x:Class="GTAIVSetupUtility.Controls.TipContent"
             x:DataType="controls:TipContent"
             x:CompileBindings="True"
             MaxWidth="420">

    <TextBlock Text="{Binding Description}"
               TextWrapping="Wrap"/>
</UserControl>
