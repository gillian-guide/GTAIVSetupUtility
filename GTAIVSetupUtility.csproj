<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\ivlogo.ico</ApplicationIcon>

        <Version>3.0.0</Version>
        <Title>GTAIVSetupUtility</Title>
        <Authors>Gillian</Authors>
        <Company>Gillian</Company>
        <Description>Semi-automatic setup utility for GTA IV</Description>
        <Copyright>Gillian</Copyright>
        <PackageProjectUrl>https://github.com/gillian-guide/GTAIVSetupUtility</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>Assets\ivlogo256.png</PackageIcon>
        <RepositoryUrl>https://github.com/gillian-guide/GTAIVSetupUtility</RepositoryUrl>
        <RepositoryType>GitHub</RepositoryType>
        <PackageTags>GTAIV</PackageTags>
        <NeutralLanguage>en-US</NeutralLanguage>

        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>link</TrimMode>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" Exclude="Assets\7z.dll;Assets\7z-LICENSE.txt"/>
        <EmbeddedResource Include="Assets\7z.dll" LogicalName="GTAIVSetupUtility.Assets.7z.dll" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="MessageBox.Avalonia"/>
        <PackageReference Include="NLog"/>
        <PackageReference Include="SevenZipExtractor"/>
        <PackageReference Include="System.Management"/>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Localizations\Resources.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Localizations\Resources.ru-RU.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.ru-RU.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Localizations\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
      <Compile Update="Localizations\Resources.ru-RU.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.ru-RU.resx</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootAssembly Include="System.Management" />
        <TrimmerRootAssembly Include="SevenZipExtractor" />
    </ItemGroup>

    <!-- The SkiaSharp/HarfBuzz packages ship native PDBs that are not needed in the release artifact. -->
    <Target Name="RemoveNativeSymbols" AfterTargets="Publish">
        <Delete Files="$(PublishDir)libHarfBuzzSharp.pdb;$(PublishDir)libSkiaSharp.pdb" />
    </Target>
</Project>
